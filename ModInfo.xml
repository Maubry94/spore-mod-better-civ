<mod displayName="Better Civ" unique="BetterCiv" description="Ten major cities and configurable rules for Spore's Civilization Stage." installerSystemVersion="1.0.1.2" hasCustomInstaller="true" isExperimental="false" dllsBuild="2.5.290">
  <componentGroup displayName="Vehicle Cost" unique="VehicleCost">
    <component game="GalacticAdventures" displayName="Vanilla (1x)" description="Use the original vehicle prices." unique="CostVanilla" defaultChecked="true">CivInsanity-Option-PrixVanilla.package</component>
    <component game="GalacticAdventures" displayName="75% of Vanilla" description="Reduce vehicle prices by 25%." unique="Cost75" defaultChecked="false">CivInsanity-Option-PrixModere.package</component>
    <component game="GalacticAdventures" displayName="50% of Vanilla" description="Reduce vehicle prices by 50%." unique="Cost50" defaultChecked="false">CivInsanity-Option-PrixReduits.package</component>
  </componentGroup>
  <componentGroup displayName="Firing Interval" unique="FiringInterval">
    <component game="GalacticAdventures" displayName="Vanilla (2 s)" description="Use the original 2-second firing interval." unique="FiringVanilla" defaultChecked="true">CivInsanity-Option-TirVanilla.package</component>
    <component game="GalacticAdventures" displayName="1.5 Seconds" description="Set the firing interval to 1.5 seconds." unique="Firing1500ms" defaultChecked="false">CivInsanity-Option-TirModere.package</component>
    <component game="GalacticAdventures" displayName="0.5 Seconds" description="Set the firing interval to 0.5 seconds." unique="Firing500ms" defaultChecked="false">CivInsanity-Option-TirRapide.package</component>
  </componentGroup>
  <componentGroup displayName="Vehicle Speed" unique="VehicleSpeed">
    <component game="GalacticAdventures" displayName="Vanilla (1x)" description="Use the original vehicle speeds." unique="SpeedVanilla" defaultChecked="true">CivInsanity-Option-VitesseVanilla.package</component>
    <component game="GalacticAdventures" displayName="125% of Vanilla" description="Increase land, sea and air vehicle speed by 25%." unique="Speed125" defaultChecked="false">CivInsanity-Option-Vitesse125.package</component>
    <component game="GalacticAdventures" displayName="150% of Vanilla" description="Increase land, sea and air vehicle speed by 50%." unique="Speed150" defaultChecked="false">CivInsanity-Option-Vitesse150.package</component>
  </componentGroup>
  <componentGroup displayName="Offensive Units" unique="OffensiveUnits">
    <component game="GalacticAdventures" displayName="Vanilla (8)" description="Use the default target of 8 offensive units during Civilization planet generation." unique="OffensiveUnitsVanilla" defaultChecked="true">CivInsanity-Option-OffensifsVanilla.package</component>
    <component game="GalacticAdventures" displayName="12 Units" description="Set the offensive unit target to 12 during planet generation." unique="OffensiveUnits12" defaultChecked="false">CivInsanity-Option-Offensifs12.package</component>
    <component game="GalacticAdventures" displayName="16 Units" description="Set the offensive unit target to 16 during planet generation." unique="OffensiveUnits16" defaultChecked="false">CivInsanity-Option-Offensifs16.package</component>
  </componentGroup>
  <componentGroup displayName="AI Population" unique="AIPopulation">
    <component game="GalacticAdventures" displayName="Vanilla (15)" description="Each rival starts with a population of 15." unique="PopulationVanilla" defaultChecked="true">CivInsanity-Option-PopulationVanilla.package</component>
    <component game="GalacticAdventures" displayName="30 per Rival" description="Each rival starts with a population of 30." unique="Population30" defaultChecked="false">CivInsanity-Option-PopulationEgale30.package</component>
    <component game="GalacticAdventures" displayName="15-50 per Rival" description="Rivals start with a population between 15 and 50." unique="Population15To50" defaultChecked="false">CivInsanity-Option-PopulationVariable.package</component>
  </componentGroup>
  <componentGroup displayName="AI Starting Funds" unique="AIStartingFunds">
    <component game="GalacticAdventures" displayName="Vanilla (4,000)" description="Each rival starts with 4,000 Sporebucks." unique="FundsVanilla" defaultChecked="true">CivInsanity-Option-TresorerieVanilla.package</component>
    <component game="GalacticAdventures" displayName="8,000 per Rival" description="Each rival starts with 8,000 Sporebucks." unique="Funds8000" defaultChecked="false">CivInsanity-Option-TresorerieEgale8000.package</component>
    <component game="GalacticAdventures" displayName="4,000-15,000" description="Rivals start with between 4,000 and 15,000 Sporebucks." unique="Funds4000To15000" defaultChecked="false">CivInsanity-Option-TresorerieVariable.package</component>
  </componentGroup>
  <componentGroup displayName="AI Specialties" unique="AISpecialties">
    <component game="GalacticAdventures" displayName="Equal Odds" description="Each rival has an equal chance of being military, religious or economic." unique="EqualOdds" defaultChecked="true">CivInsanity-Option-TroisSpecialites.package</component>
    <component game="GalacticAdventures" displayName="Balanced (3/3/3)" description="Start with exactly three military, three religious and three economic rivals." unique="Balanced333" defaultChecked="false">BetterCiv-Option-Balanced333.package</component>
    <component game="GalacticAdventures" displayName="No Military" description="Rivals have a 50/50 chance of being religious or economic." unique="NoMilitary" defaultChecked="false">CivInsanity-Option-SansMilitaires.package</component>
    <component game="GalacticAdventures" displayName="No Religious" description="Rivals have a 50/50 chance of being military or economic." unique="NoReligious" defaultChecked="false">CivInsanity-Option-SansReligieuses.package</component>
    <component game="GalacticAdventures" displayName="No Economic" description="Rivals have a 50/50 chance of being military or religious." unique="NoEconomic" defaultChecked="false">CivInsanity-Option-SansEconomiques.package</component>
    <component game="GalacticAdventures" displayName="Military Only" description="All rivals start as military nations." unique="MilitaryOnly" defaultChecked="false">CivInsanity-Option-MilitairesSeulement.package</component>
    <component game="GalacticAdventures" displayName="Religious Only" description="All rivals start as religious nations." unique="ReligiousOnly" defaultChecked="false">CivInsanity-Option-ReligieusesSeulement.package</component>
    <component game="GalacticAdventures" displayName="Economic Only" description="All rivals start as economic nations." unique="EconomicOnly" defaultChecked="false">CivInsanity-Option-EconomiquesSeulement.package</component>
  </componentGroup>
  <componentGroup displayName="Captured Cities" unique="CapturedCities">
    <component game="GalacticAdventures" displayName="Vanilla" description="Use the original rules for city specialties after an AI capture." unique="CaptureVanilla" defaultChecked="true">CivInsanity-Option-CaptureVanilla.package</component>
    <component game="GalacticAdventures" displayName="Keep Specialty" description="Cities captured by a rival keep their old specialty. The player keeps the usual choice." unique="KeepSpecialty" defaultChecked="false">CivInsanity-Option-CaptureConserve.package</component>
  </componentGroup>
  <componentGroup displayName="Turrets &amp; Fleets" unique="TurretsAndFleets">
    <component game="GalacticAdventures" displayName="Vanilla" description="Use original turret and fleet limits. Large cities have 8 military, 6 religious or 4 economic turret slots." unique="TurretsVanilla" defaultChecked="true">CivInsanity-Option-TourellesVanilla.package</component>
    <component game="GalacticAdventures" displayName="Max by Type (Hard)" description="On Hard, rivals aim for 8, 6 or 4 turrets by city type. Player and rival fleet caps rise by about 38% before rounding. Other difficulties use vanilla rules." unique="MaxByTypeOnHard" defaultChecked="false">CivInsanity-Option-TourellesMaximum.package</component>
    <component game="GalacticAdventures" displayName="8 Slots per City" description="All large cities get 8 slots. On Hard, rivals aim to fill all 8. Fleet caps rise by about 85% on Hard, 33% on Normal and 50% on Easy." unique="EightSlotsPerCity" defaultChecked="false">CivInsanity-Option-TourellesTous.package</component>
  </componentGroup>
  <componentGroup displayName="Trade" unique="TradeBehavior">
    <component game="GalacticAdventures" displayName="Vanilla" description="Use the original trade-partner conditions and retreat behavior when traders are hit." unique="TradeVanilla" defaultChecked="false">BetterCiv-Option-TradeVanilla.package</component>
    <component game="GalacticAdventures" displayName="Better Trade" description="Help economic rivals open their first route to a reachable rival city when both nations are at least neutral. Land, sea and air traders keep their course under fire, but still take damage. Deliveries and city purchases follow the original rules." unique="BetterTrade" defaultChecked="true">BetterCiv-Option-BetterTrade.package</component>
  </componentGroup>
  <componentGroup displayName="AI Behavior" unique="AIBehavior">
    <component game="GalacticAdventures" displayName="Vanilla" description="Keep the original offensive targets, movement and vehicle-retirement decisions. Core city, conversion and diplomacy fixes remain active." unique="AIVanilla" defaultChecked="true">BetterCiv-Option-AIVanilla.package</component>
    <component game="GalacticAdventures" displayName="Better AI" description="EXPERIMENTAL: Reconsider failed offensives; abandon engaged sieges after 3 minutes without a new conquest or conversion high, then avoid that city for 2 minutes. Help blocked vehicles find nearby space. Gradually sell idle surplus AI land units to make room for ships. After all ports are lost, idle combat ships try an enemy port; idle ships without a useful role can be sold. Protect active missions and player fleets from sales." unique="BetterAI" defaultChecked="false">BetterCiv-Option-BetterAI.package</component>
  </componentGroup>
  <componentGroup displayName="AI Diagnostics (Dev)" unique="AIDiagnostics">
    <component game="GalacticAdventures" displayName="Off" description="Do not write the optional AI diagnostic journal." unique="DiagnosticsOff" defaultChecked="true">BetterCiv-Option-DiagnosticsOff.package</component>
    <component game="GalacticAdventures" displayName="On" description="Record AI decisions, conversions and combat. Visible battles also get detailed movement, building targets and turret logs. Read-only, with bounded output." unique="DiagnosticsOn" defaultChecked="false">BetterCiv-Option-DiagnosticsOn.package</component>
  </componentGroup>
  <prerequisite game="GalacticAdventures">CivInsanity-Specialites.package</prerequisite>
  <prerequisite>BetterCiv.dll</prerequisite>
</mod>
